.env
.env.*
!.env.example
*.env.local

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.tox/

# ============================================================
# Base de datos local (no versionar)
# ============================================================
*.db
*.sqlite
*.sqlite3
backend/solinfnet.db
data/solinfnet.db

