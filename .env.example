# ============================================================
# Plantilla de variables de entorno — SolinfNet Control Center
# ============================================================
# Copiar a `.env` y rellenar los valores reales.
# `.env` está en `.gitignore` y NUNCA debe versionarse.
# ============================================================

# Versión objetivo de SolinfNet a desplegar en los gateways
TARGET_VERSION=6.5

# Usuario SSH para acceder a los gateways Raspberry Pi
SSH_USER=solinfnet

# Contraseña SSH de los gateways (CAMBIAR en cada despliegue)
# NOTA: rotar inmediatamente y, si es posible, migrar a claves SSH.
RASP_PASSWORD=

# ============================================================
# C-2: API Key de acceso al panel (generar con: openssl rand -hex 32)
# Si se deja vacía, la autenticación queda DESHABILITADA (modo dev).
# Para producción, DEFINIRLA OBLIGATORIAMENTE.
# ============================================================
API_KEY=

# ============================================================
# Integración opcional de solo lectura con Zabbix
# Crear un token con un usuario dedicado y permisos de lectura.
# Nunca añadir el token real a Git.
# ============================================================
ZABBIX_ENABLED=false
ZABBIX_URL=http://zabbix.example.local/zabbix/api_jsonrpc.php
ZABBIX_TOKEN=
ZABBIX_TIMEOUT_SECONDS=10
